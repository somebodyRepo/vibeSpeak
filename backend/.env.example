# App
DEBUG=false

# Server
HOST=::
PORT=8000

# Auth (留空禁用认证)
AUTH_TOKEN=

# LLM Provider: anthropic | openai | deepseek | zhipu
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

# Zhipu (智谱清言)
ZHIPU_API_KEY=xxx
ZHIPU_MODEL=glm-4

# ASR
ASR_DEVICE=auto  # auto | cpu | mps | cuda
